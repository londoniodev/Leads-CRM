datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lead {
  id             String          @id @default(uuid())
  leadHash       String          @unique // Hash determinista md5(website | phoneE164)
  companyName    String
  niche          String
  source         String          @default("GOOGLE_MAPS")
  city           String?
  country        String?
  address        String?
  website        String?         // NO usar @unique
  phoneE164      String?         
  rawPhone       String?
  primaryEmail   String?
  placeId        String?
  rating         Float?
  reviewsCount   Int?
  googleCategory String?
  status         LeadStatus      @default(NEW)
  score          Int             @default(0)
  
  socialProfiles SocialProfile[]
  contacts       ContactPerson[]
  proposal       LeadProposal?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
}

model LeadProposal {
  id                 String   @id @default(uuid())
  leadId             String   @unique
  lead               Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  painDiagnosis      String   @db.Text
  transformationGoal String   @db.Text
  pilar1Leads        String   @db.Text
  pilar2Conversion   String   @db.Text
  pilar3Automation   String   @db.Text
  whatsappPitch      String   @db.Text
  coldEmailPitch     String   @db.Text
  callScript         String   @db.Text

  isCustomized       Boolean  @default(false)
  generatedAt        DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@index([leadId])
}

model SocialProfile {
  id           String              @id @default(uuid())
  leadId       String?
  lead         Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  platform     Platform 
  url          String
  username     String?
  followers    Int?
  bio          String?
  emailInBio   String?
  verified     Boolean             @default(false)
  status       SocialProfileStatus @default(LINKED)
  conflictNote String?

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt

  @@index([leadId, platform])
  @@index([platform, username])
  @@index([status])
}

model ContactPerson {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  name        String?
  role        String? 
  email       String?
  phone       String?
  linkedinUrl String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

enum Platform {
  GOOGLE_MAPS
  INSTAGRAM
  TIKTOK
  LINKEDIN
  FACEBOOK
}

enum LeadStatus {
  NEW
  ENRICHING
  ENRICHED
  QUALIFIED
  REJECTED
}

enum SocialProfileStatus {
  LINKED
  CONFLICTED
}
